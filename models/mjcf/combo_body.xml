<mujoco model="spacecraft_combo">
  <compiler angle="radian" meshdir="../meshes"/>

  <!-- ===== 仿真参数 ===== -->
  <option timestep="0.002" gravity="0 0 0" integrator="RK4"/>

  <!-- ===== 默认材质 & 关节配置 ===== -->
  <default>
    <geom rgba="0.5 0.5 0.5 1"/>
    <joint type="free" limited="false"/>
  </default>

  <!-- ===== 光照 & 相机 ===== -->
  <visual>
    <global offwidth="1920" offheight="1080"/>
    <light pos="5 5 5"/>
  </visual>

  <!-- =================================================================== -->
  <!-- 小型服务航天器 (我方) — 1×1×1 m, 100 kg                             -->
  <!-- =================================================================== -->
  <body name="service_sat" pos="0 0 0">
    <inertial pos="0 0 0" mass="100"
              diaginertia="16.667 16.667 16.667"/>
    <!-- 主体 -->
    <geom name="service_body" type="box" size="0.5 0.5 0.5"
          rgba="0.2 0.5 0.8 1"/>

    <!-- 8 个推力器安装位 (site) — 面心 ± 推力方向 -->
    <!-- ±X面 -->
    <site name="s_thr_px" pos="0.55 0 0"    euler="0 1.5708 0"/>
    <site name="s_thr_nx" pos="-0.55 0 0"   euler="0 -1.5708 0"/>
    <!-- ±Y面 -->
    <site name="s_thr_py" pos="0 0.55 0"    euler="-1.5708 0 0"/>
    <site name="s_thr_ny" pos="0 -0.55 0"   euler="1.5708 0 0"/>
    <!-- ±Z面 -->
    <site name="s_thr_pz" pos="0 0 0.55"    euler="0 0 0"/>
    <site name="s_thr_nz" pos="0 0 -0.55"   euler="3.1416 0 0"/>
    <!-- 辅助推力器 (对角线方向，增强力矩能力) -->
    <site name="s_thr_aux1" pos="0.3 0.3 0.3"   euler="0.785 0.615 0"/>
    <site name="s_thr_aux2" pos="-0.3 -0.3 -0.3" euler="-2.356 0.615 0"/>
  </body>

  <!-- =================================================================== -->
  <!-- 大型非合作目标 — 3×2×2 m, 500 kg, 带太阳翼                       -->
  <!-- =================================================================== -->
  <body name="target_sat" pos="2.5 0 0">
    <inertial pos="0 0 0" mass="500"
              diaginertia="416.667 541.667 541.667"/>
    <!-- 主体 -->
    <geom name="target_body" type="box" size="1.5 1.0 1.0"
          rgba="0.8 0.2 0.2 1"/>
    <!-- 太阳翼 (两片平板，增加惯量不对称性) -->
    <geom name="target_panel_py" type="box" size="0.05 2.0 1.0"
          pos="0 2.05 0" rgba="0.1 0.3 0.8 0.7"/>
    <geom name="target_panel_ny" type="box" size="0.05 2.0 1.0"
          pos="0 -2.05 0" rgba="0.1 0.3 0.8 0.7"/>

    <!-- 8 个推力器安装位 -->
    <site name="t_thr_px" pos="1.55 0 0"    euler="0 1.5708 0"/>
    <site name="t_thr_nx" pos="-1.55 0 0"   euler="0 -1.5708 0"/>
    <site name="t_thr_py" pos="0 1.05 0"    euler="-1.5708 0 0"/>
    <site name="t_thr_ny" pos="0 -1.05 0"   euler="1.5708 0 0"/>
    <site name="t_thr_pz" pos="0 0 1.05"    euler="0 0 0"/>
    <site name="t_thr_nz" pos="0 0 -1.05"   euler="3.1416 0 0"/>
    <site name="t_thr_aux1" pos="0.5 0.5 0.5"    euler="0.785 0.615 0"/>
    <site name="t_thr_aux2" pos="-0.5 -0.5 -0.5" euler="-2.356 0.615 0"/>
  </body>

  <!-- =================================================================== -->
  <!-- 连接约束：已捕获组合体                                              -->
  <!-- =================================================================== -->
  <equality>
    <weld name="captured" body1="service_sat" body2="target_sat"
          relpose="2.5 0 0 1 0 0 0"/>
  </equality>

  <!-- =================================================================== -->
  <!-- 执行器 (每轴向力矩 → 由 env 代码分配推力器合力)                    -->
  <!-- =================================================================== -->
  <actuator>
    <general name="tau_x" site="s_thr_px" gaintype="fixed"/>
    <general name="tau_y" site="s_thr_py" gaintype="fixed"/>
    <general name="tau_z" site="s_thr_pz" gaintype="fixed"/>
  </actuator>

</mujoco>
