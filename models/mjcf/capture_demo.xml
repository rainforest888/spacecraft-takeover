<mujoco model="spacecraft_capture_demo">
  <compiler angle="radian" meshdir="../meshes"/>

  <option timestep="0.002" gravity="0 0 0"/>

  <visual>
    <global offwidth="1920" offheight="1080" azimuth="135" elevation="-15"/>
    <quality shadowsize="4096"/>
  </visual>

  <asset>
    <texture name="earth_tex" type="2d" builtin="gradient" width="512" height="512"
             rgb1="0.1 0.3 0.7" rgb2="0.05 0.15 0.4"/>
    <material name="earth_mat" texture="earth_tex" specular="0.1" shininess="0.1"/>
    <material name="svc_body_mat" rgba="0.3 0.6 0.9 1" specular="0.7" shininess="0.4" emission="0.05"/>
    <material name="claw_mat" rgba="0.75 0.75 0.75 1" specular="1.0" shininess="0.7" emission="0.03"/>
    <material name="claw_tip_mat" rgba="0.85 0.85 0.85 1" specular="1.0" shininess="0.8" emission="0.04"/>
    <material name="target_mat" rgba="0.9 0.2 0.2 1" specular="0.6" shininess="0.3" emission="0.03"/>
    <material name="panel_mat" rgba="0.15 0.35 0.9 0.8" specular="0.5" shininess="0.2" emission="0.02"/>
  </asset>

  <default>
    <geom rgba="0.5 0.5 0.5 1"/>
  </default>

  <worldbody>
    <!-- ═══ Earth (orbital context) ═══ -->
    <light name="sun" directional="true" diffuse="1.2 1.2 1.2" specular="0.6 0.6 0.6"
           pos="10 5 -8" dir="-1 -0.3 0.5" castshadow="true"/>
    <light name="ambient" directional="false" diffuse="0.5 0.5 0.6"/>
    <light name="fill" directional="true" diffuse="0.4 0.4 0.5" specular="0.2 0.2 0.2"
           pos="-5 3 5" dir="1 -0.5 -1"/>

    <body name="earth" pos="-8 3 -5">
      <geom name="earth_geom" type="sphere" size="3.5" material="earth_mat"/>
    </body>

    <!-- ═══ Service Satellite + Claw Cage ═══ -->
    <!-- Claw arms extend +X, wrapping around target body (X=1.0, half-size 0.5 -> spans 0.5-1.5) -->
    <body name="service_sat" pos="0 0 0">
      <freejoint/>
      <inertial pos="0 0 0" mass="100"
                diaginertia="16.667 16.667 16.667"/>
      <!-- Central body -->
      <geom name="service_body" type="box" size="0.2 0.2 0.2" material="svc_body_mat"/>

      <!-- Claw base ring on service body +X face -->
      <geom name="claw_base_t" type="box" size="0.02 0.28 0.02"
            pos="0.22 0.28 0"    material="claw_mat"/>
      <geom name="claw_base_b" type="box" size="0.02 0.28 0.02"
            pos="0.22 -0.28 0"   material="claw_mat"/>
      <geom name="claw_base_l" type="box" size="0.02 0.02 0.28"
            pos="0.22 0 0.28"    material="claw_mat"/>
      <geom name="claw_base_r" type="box" size="0.02 0.02 0.28"
            pos="0.22 0 -0.28"   material="claw_mat"/>

      <!-- 4 Long claw arms — extend from X=0.22 to X=1.72, wrapping past target -->
      <geom name="claw_top"    type="box" size="0.025 0.025 0.75"
            pos="0.97 0.32 0"    material="claw_mat"/>
      <geom name="claw_bottom" type="box" size="0.025 0.025 0.75"
            pos="0.97 -0.32 0"   material="claw_mat"/>
      <geom name="claw_left"   type="box" size="0.025 0.025 0.75"
            pos="0.97 0 0.32"    material="claw_mat"/>
      <geom name="claw_right"  type="box" size="0.025 0.025 0.75"
            pos="0.97 0 -0.32"   material="claw_mat"/>

      <!-- Mid crossbars (at target body center X=1.0) -->
      <geom name="claw_mid_t" type="box" size="0.018 0.28 0.018"
            pos="1.0 0.32 0"    material="claw_mat"/>
      <geom name="claw_mid_b" type="box" size="0.018 0.28 0.018"
            pos="1.0 -0.32 0"   material="claw_mat"/>
      <geom name="claw_mid_l" type="box" size="0.018 0.018 0.28"
            pos="1.0 0 0.32"    material="claw_mat"/>
      <geom name="claw_mid_r" type="box" size="0.018 0.018 0.28"
            pos="1.0 0 -0.32"   material="claw_mat"/>

      <!-- Tip crossbars (past target far end X=1.5, at X=1.68) -->
      <geom name="claw_tip_t" type="box" size="0.02 0.30 0.02"
            pos="1.68 0.32 0"    material="claw_tip_mat"/>
      <geom name="claw_tip_b" type="box" size="0.02 0.30 0.02"
            pos="1.68 -0.32 0"   material="claw_tip_mat"/>
      <geom name="claw_tip_l" type="box" size="0.02 0.02 0.30"
            pos="1.68 0 0.32"    material="claw_tip_mat"/>
      <geom name="claw_tip_r" type="box" size="0.02 0.02 0.30"
            pos="1.68 0 -0.32"   material="claw_tip_mat"/>

      <!-- Thruster sites -->
      <site name="s_thr_px" pos="0.25 0 0"    euler="0 1.5708 0"/>
      <site name="s_thr_nx" pos="-0.25 0 0"   euler="0 -1.5708 0"/>
      <site name="s_thr_py" pos="0 0.25 0"    euler="-1.5708 0 0"/>
      <site name="s_thr_ny" pos="0 -0.25 0"   euler="1.5708 0 0"/>
      <site name="s_thr_pz" pos="0 0 0.25"    euler="0 0 0"/>
      <site name="s_thr_nz" pos="0 0 -0.25"   euler="3.1416 0 0"/>
    </body>

    <!-- ═══ Target Spacecraft (sits INSIDE claw cage) ═══ -->
    <!-- Target body at X=1.0 spans X=0.5-1.5; claw arms span X=0.22-1.72 -> fully enclosed -->
    <body name="target_sat" pos="1.0 0 0">
      <freejoint/>
      <inertial pos="0 0 0" mass="500"
                diaginertia="500 500 500"/>
      <geom name="target_body" type="box" size="0.5 0.25 0.25" material="target_mat"/>
      <!-- Solar panels -->
      <geom name="target_panel_py" type="box" size="0.03 0.8 0.25"
            pos="0 1.05 0" material="panel_mat"/>
      <geom name="target_panel_ny" type="box" size="0.03 0.8 0.25"
            pos="0 -1.05 0" material="panel_mat"/>

      <!-- Thruster sites -->
      <site name="t_thr_px" pos="0.53 0 0"    euler="0 1.5708 0"/>
      <site name="t_thr_nx" pos="-0.53 0 0"   euler="0 -1.5708 0"/>
      <site name="t_thr_py" pos="0 0.28 0"    euler="-1.5708 0 0"/>
      <site name="t_thr_ny" pos="0 -0.28 0"   euler="1.5708 0 0"/>
      <site name="t_thr_pz" pos="0 0 0.28"    euler="0 0 0"/>
      <site name="t_thr_nz" pos="0 0 -0.28"   euler="3.1416 0 0"/>
    </body>
  </worldbody>

  <equality>
    <weld name="captured" body1="service_sat" body2="target_sat"
          relpose="1.0 0 0 1 0 0 0"/>
  </equality>

  <actuator>
    <general name="tau_x" site="s_thr_px" gaintype="fixed"/>
    <general name="tau_y" site="s_thr_py" gaintype="fixed"/>
    <general name="tau_z" site="s_thr_pz" gaintype="fixed"/>
  </actuator>
</mujoco>
